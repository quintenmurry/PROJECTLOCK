# Copy to .env.local for secrets. Public values already live in .env.

# Server-only. Needed from Milestone 3 (guest job links). Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional transactional email via Resend. Without these, emails are printed to the
# server console and invite links are shown on screen.
# RESEND_API_KEY=
# EMAIL_FROM="ProjectLock <notifications@yourdomain.com>"
